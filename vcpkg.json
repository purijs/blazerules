{
  "name" : "blazerules",
  "version" : "0.5.0",
  "builtin-baseline" : "eb35a05cc21c69ec1399f7532b7dd61d271ac0d1",
  "dependencies" : [ "arrow", "abseil", "tbb", "yaml-cpp", "re2", "cpp-httplib", {
    "name" : "simdjson",
    "version>=" : "4.6.4"
  } ],
  "features" : {
    "onnx" : {
      "description" : "Embedded ONNX Runtime ML scoring (model_score operator)",
      "dependencies" : [ "onnxruntime" ]
    },
    "io" : {
      "description" : "Streaming/IO connectors: Kafka (librdkafka)",
      "dependencies" : [ "librdkafka" ]
    },
    "io-protobuf" : {
      "description" : "Optional BlazeRules IO protobuf dynamic descriptor decoder",
      "dependencies" : [ "protobuf" ]
    },
    "io-avro" : {
      "description" : "Optional BlazeRules IO Avro decoder feature gate",
      "dependencies" : [ "avro-cpp" ]
    },
    "io-s3" : {
      "description" : "Optional s3:// file ingestion through Arrow filesystem",
      "dependencies" : [ {
        "name" : "arrow",
        "features" : [ "s3" ]
      } ]
    },
    "tests" : {
      "description" : "Build the BlazeRules C++ test suite",
      "dependencies" : [ "gtest" ]
    }
  },
  "default-features" : [ "onnx", "io", "io-avro", "io-protobuf", "io-s3" ]
}
